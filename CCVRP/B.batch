# Cumulative CVRP: instances of the set B of the CVRP demo, with the number of routes of the CVRP batch.
# The model uses a custom resource: the BaPCod/RCSP library must be built with src/meta_solver/rcsp_custom_res_impl.*
# copied to Tools/rcsp (src and include_dev).
# Tip: after a batch execution, call 'grep statistics: out/B.out -h | cut -c13-' to get the results as rows for a LaTeX table.
# julia src/run.jl -b B.batch &> out/B.out
# Upper bounds are optimal costs + 1 (optima found by this demo, November 2026, in at most 2 minutes each).
# Instances not solved in 2 minutes are commented out (best lower bound after 2 minutes in parentheses).
data/B/B-n38-k6.vrp -m 6 -M 6 -u 28509
data/B/B-n39-k5.vrp -m 5 -M 5 -u 19983
data/B/B-n41-k6.vrp -m 6 -M 6 -u 33131
data/B/B-n43-k6.vrp -m 6 -M 6 -u 27978
data/B/B-n44-k7.vrp -m 7 -M 7 -u 37083
data/B/B-n45-k5.vrp -m 5 -M 5 -u 25361
data/B/B-n45-k6.vrp -m 6 -M 6 -u 27595
data/B/B-n50-k8.vrp -m 8 -M 8 -u 50644
# data/B/B-n50-k7.vrp -m 7 -M 7   (not solved in 2 minutes; lower bound 27583)
# data/B/B-n51-k7.vrp -m 7 -M 7   (not solved in 2 minutes; lower bound 43231)
data/B/B-n52-k7.vrp -m 7 -M 7 -u 28536
data/B/B-n56-k7.vrp -m 7 -M 7 -u 25088
data/B/B-n57-k9.vrp -m 9 -M 9 -u 65712
# data/B/B-n57-k7.vrp -m 7 -M 7   (not solved in 2 minutes; lower bound 50314)
# data/B/B-n63-k10.vrp -m 10 -M 10   (not solved in 2 minutes; lower bound 61647)
data/B/B-n64-k9.vrp -m 9 -M 9 -u 35458
# data/B/B-n66-k9.vrp -m 9 -M 9   (not solved in 2 minutes; lower bound 52564)
# data/B/B-n67-k10.vrp -m 10 -M 10   (not solved in 2 minutes; lower bound 39620)
# data/B/B-n68-k9.vrp -m 9 -M 9   (not solved in 2 minutes; lower bound 51975)
data/B/B-n78-k10.vrp -m 10 -M 10 -u 46469
